--langdef=scala
--langmap=scala:.scala
--regex-scala=/^.*case class[ \t]+([a-zA-Z0-9_\\&\/]+)/\1/c,case classes/
--regex-scala=/^.*class[ \t]+([a-zA-Z0-9_\\&\/]+)/\1/c,classes/
--regex-scala=/^.*trait[ \t]+([a-zA-Z0-9_\\&\/]+)/\1/t,traits/
--regex-scala=/^.*object[ \t]+([a-zA-Z0-9_\\&\/]+)/\1/o,objects/
--regex-scala=/^.*type[ \t]+([a-zA-Z0-9_\\&\/]+)/\1/T,types/
--regex-scala=/^.*def[ \t]+([a-zA-Z0-9_\\&\/\?]+)/\1/m,methods/
--regex-scala=/^.*val[ \t]+([a-zA-Z0-9_\\&\/]+)/\1/C,constants/
--regex-scala=/^.*var[ \t]+([a-zA-Z0-9_\\&\/]+)/\1/l,local variables/
--regex-scala=/^.*package[ \t]+([a-zA-Z0-9_.]+)/\1/p,packages/
--langdef=puppet
--langmap=puppet:.pp
--regex-puppet=/^class[ \t]+([:a-zA-Z0-9_\\&\/]+)/\1/d,definition/
--regex-puppet=/^site[ \t]+([a-zA-Z0-9_\\&\/.]+)/\1/d,definition/
--regex-puppet=/^node[ \t]+([a-zA-Z0-9_\\&\/.]+)/\1/d,definition/
--regex-puppet=/^define[ \t]+([:a-zA-Z0-9_\\&\/]+)/\1/d,definition/
--langdef=kotlin
--langmap=kotlin:+.kt
--langmap=kotlin:+.kts
--regex-kotlin=/^[[:space:]]*((internal|abstract|final|sealed|implicit|lazy|inner|open)[[:space:]]*)*(private[^ ]*|protected)?[[:space:]]*class[[:space:]]+([[:alnum:]_:]+)/\4/c,classes/
--regex-kotlin=/^[[:space:]]*((internal|abstract|final|sealed|implicit|lazy)[[:space:]]*)*(private[^ ]*|protected)?[[:space:]]*object[[:space:]]+([[:alnum:]_:]+)/\4/o,objects/
--regex-kotlin=/^[[:space:]]*((internal|abstract|final|sealed|implicit|lazy|open)[[:space:]]*)*(private[^ ]*|protected)?[[:space:]]*((abstract|final|sealed|implicit|lazy)[[:space:]]*)*data class[[:space:]]+([[:alnum:]_:]+)/\6/d,data classes/
--regex-kotlin=/^[[:space:]]*((internal|abstract|final|sealed|implicit|lazy)[[:space:]]*)*(private[^ ]*|protected)?[[:space:]]*interface[[:space:]]+([[:alnum:]_:]+)/\4/i,interfaces/
--regex-kotlin=/^[[:space:]]*type[[:space:]]+([[:alnum:]_:]+)/\1/T,types/
--regex-kotlin=/^[[:space:]]*((internal|abstract|final|sealed|implicit|lazy|override|inline|open|private[^ ]*(\[[a-z]*\])*|protected|internal)[[:space:]]*)*fun[[:space:]]+(<[[:alpha:]]+(,[[:alpha:]])*>[[:space:]]+)?([[:alnum:]_:]+)/\6/m,methods/
--regex-kotlin=/^[[:space:]]*((internal|abstract|final|sealed|implicit|lazy|override|private[^ ]*|protected)[[:space:]]*)*(const[[:space:]])*val[[:space:]]+([[:alnum:]_]+)/\4/C,constants/
--regex-kotlin=/^[[:space:]]*((internal|abstract|final|sealed|implicit|lazy|override|private[^ ]*|protected)[[:space:]]*)*(lateinit[[:space:]]*)*var[[:space:]]+([[:alnum:]_]+)/\4/v,variables/
--regex-kotlin=/^[[:space:]]*package[[:space:]]+([[:alnum:]_.:]+)/\1/p,packages/