# -*- mode: sh; sh-shell: zsh; -*-
# Settings common to any WSL host. Sourced automatically from zshrc when
# running under WSL, before the per-host file so that hosts can override.

# Open files/directories in the Windows default handler
winopen() {
    /mnt/c/Windows/explorer.exe $(wslpath -w $1)
}

# Make Windows PowerShell available to WSL CLI clipboard integrations.
if [[ -d /mnt/c/Windows/System32/WindowsPowerShell/v1.0 ]]; then
    path+=(/mnt/c/Windows/System32/WindowsPowerShell/v1.0)
fi

# Make WSL interop tools available so xdg-open can delegate URLs to Windows.
if [[ -d /mnt/c/Windows ]]; then
    path+=(/mnt/c/Windows)
fi
if [[ -d /mnt/c/Windows/System32 ]]; then
    path+=(/mnt/c/Windows/System32)
fi

# Use the Windows browser for URLs
export BROWSER=xdg-open
